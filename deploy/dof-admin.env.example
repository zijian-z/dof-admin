# HTTP listen address.
DNF_ADMIN_ADDR=:8080

# Prefer a full DSN when possible.
# DNF_DSN='root:password@tcp(127.0.0.1:3306)/?charset=utf8mb4&parseTime=true&loc=Local'

# Or let the server build the DSN from these values.
DNF_DB_HOST=127.0.0.1
DNF_DB_PORT=3306
DNF_DB_USER=root
DNF_DB_PASSWORD=change-me

# PVF is required for the item library.
DNF_PVF=/opt/dof-admin/data/Script.pvf

# NPK is optional. Set it to enable item icon rendering.
# DNF_NPK_ROOT=/opt/dof-admin/data/npk
