# HTTP listen address.
DNF_ADMIN_ADDR=:8080

# Prefer a full DSN when possible.
# DNF_DSN='root:password@tcp(127.0.0.1:3306)/?charset=utf8mb4&parseTime=true&loc=Local'

# Or let the server build the DSN from these values.
DNF_DB_HOST=127.0.0.1
DNF_DB_PORT=3306
DNF_DB_USER=root
DNF_DB_PASSWORD=change-me
DNF_DB_CHARSET=utf8mb4

# PVF is required for the item library.
# Use gb18030/gbk for Simplified Chinese PVF, or big5 for Taiwan PVF.
DNF_PVF=./Script.pvf
DNF_PVF_CHARSET=big5

# NPK is optional. Set it to ImagePacks2 to enable item icon rendering.
# The directory must contain the NPK file that owns the item's icon IMG path.
DNF_NPK_ROOT=./ImagePacks2
